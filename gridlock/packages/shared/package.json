{
  "name": "@gridlock/shared",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts src/*.test.ts",
    "stress": "node --import tsx src/sim/stress.bench.ts",
    "stress:map": "node --import tsx src/sim/map-stress.bench.ts",
    "stress:neutral": "node --import tsx src/sim/neutral-stress.bench.ts",
    "stress:duel": "node --import tsx src/sim/duel-stress.bench.ts",
    "contact": "node --import tsx src/sim/contact.bench.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
